# Скопируйте в .env и заполните: cp .env.example .env
# Файл .env никогда не коммитится.

# --- Общие ---
# production | development
APP_ENV=production
LOG_LEVEL=INFO

# Домен Mini App (A-запись указывает на VPS)
DOMAIN=app.example.ru
FRONTEND_URL=https://app.example.ru

# --- PostgreSQL ---
# Пароль: только [a-z0-9], сгенерируйте: openssl rand -hex 24
POSTGRES_USER=contact
POSTGRES_PASSWORD=change_me
POSTGRES_DB=contact
# DATABASE_URL собирается в docker-compose.yml из значений выше

# --- Безопасность ---
# Сгенерируйте: openssl rand -hex 32
SECRET_KEY=change_me
# Общий секрет backend -> bot для уведомлений: openssl rand -hex 32
BOT_INTERNAL_SECRET=change_me
# Максимальный возраст initData при входе, секунды
INITDATA_MAX_AGE_SECONDS=3600
SESSION_TTL_DAYS=7

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=https://app.example.ru

# --- DeepSeek ---
# deepseek | mock (mock — без сети и затрат, для отладки)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Пусто = значения по умолчанию: deepseek-flash для персонажа, deepseek-v4-pro для разбора
DEEPSEEK_MODEL_DIALOG=
DEEPSEEK_MODEL_ANALYSIS=
AI_TIMEOUT_SECONDS=40
AI_MAX_RETRIES=2
# Цены USD за 1M токенов; пусто = актуальные на октябрь 2026 из app/ai/pricing.py
# Пример: {"deepseek-flash": {"cache_hit": 0.003, "cache_miss": 0.15, "output": 0.6}}
AI_PRICING_JSON=

# --- Лимиты бесплатного использования ---
LIMIT_TRAININGS_PER_DAY=10
LIMIT_ANALYSES_PER_DAY=20
LIMIT_MESSAGES_PER_MINUTE=20
MAX_USER_TURNS=30
MAX_MESSAGE_CHARS=1000
MAX_CUSTOM_SITUATION_CHARS=1500

# --- Голос (после MVP) ---
SPEECH_PROVIDER=none
STT_API_KEY=
TTS_API_KEY=
